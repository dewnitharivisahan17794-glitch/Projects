{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C file to X.bin",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${workspaceFolder}/X.bin/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile the current C file and save its EXE in X.bin"
        }
    ]
}