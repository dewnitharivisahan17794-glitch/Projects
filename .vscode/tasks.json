{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C file",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-o",
                "${workspaceFolder}/X.bin/${fileBasenameNoExtension}.exe"
                
                
            ],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}